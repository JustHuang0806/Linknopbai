@model DBSportStore.Models.Customer
@{ ViewBag.Title = "Chi tiết khách hàng"; Layout = "~/Views/Shared/_StoreLayout.cshtml"; }
<h2>Chi tiết khách hàng</h2><dl class="dl-horizontal"><dt>Họ tên</dt><dd>@Model.FullName</dd><dt>Điện thoại</dt><dd>@Model.Phone</dd><dt>Email</dt><dd>@Model.Email</dd><dt>Địa chỉ</dt><dd>@Model.Address</dd></dl>
<p>@Html.ActionLink("Sửa", "Edit", new { id = Model.CustomerID }) | @Html.ActionLink("Quay lại", "Index")</p>
