@model IEnumerable<DBSportStore.Models.Customer>
@{ ViewBag.Title = "Quản lý khách hàng"; Layout = "~/Views/Shared/_StoreLayout.cshtml"; }
<h2>Quản lý khách hàng</h2><p>@Html.ActionLink("Thêm khách hàng", "Create")</p>
<table class="table table-striped"><tr><th>Họ tên</th><th>Điện thoại</th><th>Email</th><th>Địa chỉ</th><th>Thao tác</th></tr>
@foreach (var item in Model) { <tr><td>@item.FullName</td><td>@item.Phone</td><td>@item.Email</td><td>@item.Address</td><td>@Html.ActionLink("Sửa", "Edit", new { id = item.CustomerID }) | @Html.ActionLink("Chi tiết", "Details", new { id = item.CustomerID }) | @Html.ActionLink("Xóa", "Delete", new { id = item.CustomerID })</td></tr> }
</table>
