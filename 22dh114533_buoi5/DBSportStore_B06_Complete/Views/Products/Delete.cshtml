@model DBSportStore.Models.Product
@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2>Xóa sản phẩm</h2>
<h3>Bạn có chắc muốn xóa sản phẩm này không?</h3>
<h4>Thông tin sản phẩm</h4>
<hr />
@if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
{
    <div style="margin:15px 0"><img src="@Url.Content("~/Content/images/" + Model.ImageUrl)" alt="@Model.ProductName" style="width:180px;height:180px;object-fit:cover;border-radius:12px;border:1px solid #ddd" /></div>
}
<dl class="dl-horizontal">
    <dt>Tên sản phẩm</dt><dd>@Model.ProductName</dd>
    <dt>Mô tả</dt><dd>@Model.Description</dd>
    <dt>Danh mục</dt><dd>@(Model.Category == null ? "" : Model.Category.CategoryName)</dd>
    <dt>Đơn giá</dt><dd>@Model.Price.ToString("#,##0") đ</dd>
    <dt>Số lượng tồn kho</dt><dd>@Model.StockQuantity</dd>
    <dt>Trạng thái</dt><dd>@(Model.IsActive ? "Đang bán" : "Ngừng bán")</dd>
</dl>
@using (Html.BeginForm("Delete", "Products", new { id = Model.ProductID }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
    @: |
    @Html.ActionLink("Quay lại danh sách", "Index")
}
