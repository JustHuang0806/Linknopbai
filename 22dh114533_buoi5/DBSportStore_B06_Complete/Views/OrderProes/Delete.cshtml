@model DBSportStore.Models.OrderPro
@{ ViewBag.Title = "Xóa đơn hàng"; Layout = "~/Views/Shared/_StoreLayout.cshtml"; }
<h2>Xóa đơn hàng</h2><p>Bạn có chắc muốn xóa đơn hàng #@Model.OrderID?</p>
@using (Html.BeginForm("Delete", "OrderProes", new { id = Model.OrderID }, FormMethod.Post)) { @Html.AntiForgeryToken() <button type="submit" class="btn btn-danger">Xác nhận xóa</button> @Html.ActionLink("Quay lại", "Index") }
