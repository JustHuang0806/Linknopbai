@model IEnumerable<DBSportStore.Models.OrderPro>
@{ ViewBag.Title = "Quản lý đơn hàng"; Layout = "~/Views/Shared/_StoreLayout.cshtml"; }
<h2>Quản lý đơn hàng</h2><p>@Html.ActionLink("Thêm đơn hàng", "Create")</p>
<div class="table-responsive"><table class="table table-striped table-bordered">
<tr><th>Mã đơn</th><th>Ngày đặt</th><th>Khách hàng</th><th>Địa chỉ giao hàng</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr>
@foreach (var item in Model) { <tr><td>@item.OrderID</td><td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td><td>@(item.Customer == null ? "" : item.Customer.FullName)</td><td>@item.ShippingAddress</td><td>@item.TotalAmount.ToString("#,##0") đ</td><td>@item.Status</td><td>@Html.ActionLink("Sửa", "Edit", new { id = item.OrderID }) | @Html.ActionLink("Chi tiết", "Details", new { id = item.OrderID }) | @Html.ActionLink("Xóa", "Delete", new { id = item.OrderID })</td></tr> }
</table></div>
