@model DBSportStore.Models.StoreHomeViewModel
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<section class="hero">
    <div>
        <p>NEW SEASON / SPORT &amp; ACTIVE</p>
        <h1>Move better. Train stronger.</h1>
        <p>Khám phá bộ sưu tập thể thao dành cho tập luyện, thi đấu và phong cách sống năng động.</p>
        <a class="btn-brand" href="#featured-products">Mua sắm ngay</a>
    </div>
</section>

<h2 class="section-title">Tất cả sản phẩm</h2>

<div class="catalog-toolbar">
    @using (Html.BeginForm("Index", "Store", FormMethod.Get, new { @class = "catalog-search" }))
    {
        if (Model.SelectedCategoryId.HasValue)
        {
            <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId.Value" />
        }

        <input type="text"
               name="keyword"
               value="@Model.SearchTerm"
               placeholder="Tìm tên hoặc mô tả sản phẩm..."
               aria-label="Tìm tên hoặc mô tả sản phẩm" />

        <input type="number"
               name="minPrice"
               value="@Model.MinPrice"
               min="0"
               step="1000"
               placeholder="Giá từ"
               aria-label="Giá từ" />

        <input type="number"
               name="maxPrice"
               value="@Model.MaxPrice"
               min="0"
               step="1000"
               placeholder="Giá đến"
               aria-label="Giá đến" />

        @Html.DropDownList("sortOrder", new[]
        {
            new SelectListItem { Text = "Mặc định", Value = "", Selected = string.IsNullOrEmpty(Model.SortOrder) },
            new SelectListItem { Text = "Giá thấp → cao", Value = "price_asc", Selected = Model.SortOrder == "price_asc" },
            new SelectListItem { Text = "Giá cao → thấp", Value = "price_desc", Selected = Model.SortOrder == "price_desc" }
        }, new { @class = "catalog-sort", aria_label = "Sắp xếp theo giá" })

        <button type="submit" class="btn-brand">Tìm kiếm</button>
        <a class="btn-soft" href="@Url.Action("Index", "Store")">Xóa lọc</a>
    }
</div>

<div class="store-shell" id="featured-products">
    <aside class="category-panel">
        <h3>Danh mục</h3>
        <ul class="category-list">
            <li>
                <a class="@(Model.SelectedCategoryId.HasValue ? "" : "active")"
                   href="@Url.Action("Index", "Store", new { keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder })">
                    Tất cả sản phẩm
                </a>
            </li>
            @foreach (var category in Model.Categories)
            {
                <li>
                    <a class="@(Model.SelectedCategoryId == category.CategoryID ? "active" : "")"
                       href="@Url.Action("Index", "Store", new { categoryId = category.CategoryID, keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder })">
                        @category.CategoryName
                    </a>
                </li>
            }
        </ul>
    </aside>

    <section>
        <p class="catalog-result-count">Tìm thấy @Model.TotalItems sản phẩm</p>

        @if (Model.Products.Any())
        {
            <div class="product-grid">
                @foreach (var item in Model.Products)
                {
                    <article class="product-card">
                        <div class="product-image">
                            <img src="@Url.Content("~/Content/images/" + item.ImagePro)" alt="@item.NamePro" />
                        </div>
                        <div class="product-body">
                            <div style="color:#64748b;font-size:13px;">@item.CategoryName</div>
                            <div class="product-name">@item.NamePro</div>
                            <div class="product-description">@item.ShortDescription</div>
                            <div class="product-price">@item.Price.ToString("#,##0") đ</div>
                            <div class="product-actions">
                                @Html.ActionLink("Chi tiết", "Details", "Products", new { id = item.ProductID }, new { @class = "btn-soft" })
                                @if (item.StockQuantity > 0)
                                {
                                    @Html.ActionLink("Mua", "AddToCart", "ShoppingCart", new { id = item.ProductID }, new { @class = "btn-brand" })
                                }
                                else
                                {
                                    <span class="btn-disabled" aria-disabled="true">Hết hàng</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            if (Model.TotalPages > 1)
            {
                <nav class="store-pagination" aria-label="Phân trang sản phẩm">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", "Store", new { categoryId = Model.SelectedCategoryId, keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder, page = Model.CurrentPage - 1 })">← Trước</a>
                    }
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <span class="active" aria-current="page">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Store", new { categoryId = Model.SelectedCategoryId, keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder, page = i })">@i</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", "Store", new { categoryId = Model.SelectedCategoryId, keyword = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder, page = Model.CurrentPage + 1 })">Sau →</a>
                    }
                </nav>
            }
        }
        else
        {
            <div class="catalog-empty">
                <h3>Không tìm thấy sản phẩm phù hợp</h3>
                <p>Không có sản phẩm nào phù hợp với các điều kiện lọc hoặc từ khóa đang chọn.</p>
                <a class="btn-brand" href="@Url.Action("Index", "Store")">Xem tất cả sản phẩm</a>
            </div>
        }
    </section>
</div>
