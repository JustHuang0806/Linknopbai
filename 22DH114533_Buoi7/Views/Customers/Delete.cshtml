@model DBSportStore.Models.Customer
@{ ViewBag.Title = "Xóa khách hàng"; Layout = "~/Views/Shared/_StoreLayout.cshtml"; }
<h2>Xóa khách hàng</h2><p>Bạn có chắc muốn xóa khách hàng <strong>@Model.FullName</strong>?</p>
@using (Html.BeginForm("Delete", "Customers", new { id = Model.CustomerID }, FormMethod.Post)) { @Html.AntiForgeryToken() <button type="submit" class="btn btn-danger">Xác nhận xóa</button> @Html.ActionLink("Quay lại", "Index") }
