@model DBSportStore.Models.CheckoutViewModel
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}
<h2 class="section-title">Thông tin đặt hàng</h2>
<div class="checkout-grid">
    <section class="checkout-form">
        <h3>Thông tin khách hàng</h3>
        @using (Html.BeginForm("Checkout", "ShoppingCart", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="checkout-row"><div class="checkout-label">@Html.LabelFor(m => m.FullName)</div><div class="checkout-input">@Html.TextBoxFor(m => m.FullName, new { @class = "form-control-modern", placeholder = "Nguyễn Văn A" })@Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })</div></div>
            <div class="checkout-row"><div class="checkout-label">@Html.LabelFor(m => m.Phone)</div><div class="checkout-input">@Html.TextBoxFor(m => m.Phone, new { @class = "form-control-modern", placeholder = "0901234567" })@Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })</div></div>
            <div class="checkout-row"><div class="checkout-label">@Html.LabelFor(m => m.Email)</div><div class="checkout-input">@Html.TextBoxFor(m => m.Email, new { @class = "form-control-modern", placeholder = "email@example.com" })@Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })</div></div>
            <div class="checkout-row"><div class="checkout-label">@Html.LabelFor(m => m.Address)</div><div class="checkout-input">@Html.TextBoxFor(m => m.Address, new { @class = "form-control-modern", placeholder = "Địa chỉ liên hệ" })@Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })</div></div>
            <div class="checkout-row"><div class="checkout-label">@Html.LabelFor(m => m.ShippingAddress)</div><div class="checkout-input">@Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control-modern", placeholder = "Địa chỉ nhận hàng" })@Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger" })</div></div>
            <div class="checkout-row checkout-row-action"><div class="checkout-label"></div><div class="checkout-input"><button type="submit" class="btn-brand">Đặt hàng</button></div></div>
        }
    </section>
    <aside class="checkout-summary">
        <h3>Đơn hàng của bạn</h3>
        @foreach (var item in Model.Cart.Items)
        {
            <div class="checkout-product">
                <div class="checkout-product-image"><img src="@Url.Content("~/Content/images/" + item.ImageUrl)" alt="@item.ProductName" /></div>
                <div class="checkout-product-info"><strong>@item.ProductName</strong><div class="checkout-product-detail">Số lượng: <span>@item.Quantity</span></div><div class="checkout-product-detail">Đơn giá: <span>@item.UnitPrice.ToString("#,##0") đ</span></div></div>
                <div class="checkout-product-total">@item.LineTotal.ToString("#,##0") đ</div>
            </div>
        }
        <div class="checkout-grand-total"><span>Tổng cộng:</span><strong>@Model.Cart.TotalMoney().ToString("#,##0") đ</strong></div>
    </aside>
</div>
@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
