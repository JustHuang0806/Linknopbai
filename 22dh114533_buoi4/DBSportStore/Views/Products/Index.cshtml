@model IEnumerable<DBSportStore.Models.Product>
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_StoreLayout.cshtml";
}

<h2 class="section-title">Quản lý sản phẩm</h2>
<p>@Html.ActionLink("Thêm sản phẩm mới", "Create", null, new { @class = "btn-brand" })</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Ảnh</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Đơn giá</th>
                <th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@Url.Content("~/Content/images/" + item.ImageUrl)" alt="@item.ProductName" style="width:72px;height:72px;object-fit:cover;border-radius:8px" />
                    }
                </td>
                <td>@item.ProductName</td>
                <td>@(item.Category == null ? "" : item.Category.CategoryName)</td>
                <td>@item.Price.ToString("#,##0") đ</td>
                <td>@item.StockQuantity</td>
                <td>@(item.IsActive ? "Đang bán" : "Ngừng bán")</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }) |
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID })
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
