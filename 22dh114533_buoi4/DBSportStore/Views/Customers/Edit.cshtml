@model DBSportStore.Models.Customer
@{ ViewBag.Title = "Sửa khách hàng"; Layout = "~/Views/Shared/_StoreLayout.cshtml"; }
<h2>Sửa khách hàng</h2>
@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.HiddenFor(m => m.CustomerID) @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">@Html.LabelFor(m => m.FullName, "Họ tên") @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })</div>
    <div class="form-group">@Html.LabelFor(m => m.Phone, "Điện thoại") @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })</div>
    <div class="form-group">@Html.LabelFor(m => m.Email, "Email") @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })</div>
    <div class="form-group">@Html.LabelFor(m => m.Address, "Địa chỉ") @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })</div>
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button> @Html.ActionLink("Quay lại", "Index") }
